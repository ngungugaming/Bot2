{
  "name": "mc-afk-bot",
  "version": "1.0.0",
  "description": "Minecraft Bedrock AFK Bot with Web GUI (Express + Socket.io + bedrock-protocol)",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output dist/afk-bot"
  },
  "dependencies": {
    "bedrock-protocol": "^3.36.0",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-linux-x64",
      "node18-macos-x64"
    ],
    "outputPath": "dist"
  },
  "engines": {
    "node": ">=18"
  }
}
